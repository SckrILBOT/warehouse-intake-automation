# Runtime secrets. Never put values in source or in browser-exposed variables.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# SHA-256 of a generated 128-bit (22 character base64url) owner access key.
# Do not use a hash of a human-selected password with this token-based scheme.
OWNER_ACCESS_KEY_HASH=
# Test target only. Store all three as server secrets.
MAIL_TEST_ACCOUNT=
MAIL_TEST_PASSWORD=
MAIL_TEST_PATH=/Sklad_test.xlsx
# Separate work connection. Set active profile only after validating a copy.
MAIL_ACTIVE_PROFILE=test
MAIL_WORK_ACCOUNT=
MAIL_WORK_PASSWORD=
MAIL_WORK_PATH=/Warehouse/Stock.xlsx
